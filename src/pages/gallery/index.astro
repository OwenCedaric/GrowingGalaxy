---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getPhotos } from "@/utils/photos";
import { PhotoGrid } from "@/components/gallery/PhotoGrid";
import TextReveal from "@/components/ui/TextReveal";

const photos =
    await getPhotos();
const siteUrl =
    Astro.site
        ? Astro.site
              .toString()
              .replace(
                  /\/$/,
                  "",
              )
        : `${SITE_CONFIG.site}`;
const currentYear =
    new Date().getFullYear();

const ldJsons =
    photos.map(
        (
            photo,
        ) => ({
            "@context":
                "https://schema.org/",
            "@type":
                "ImageObject",
            contentUrl:
                photo
                    .images[0]
                    .url,
            license: `${siteUrl}/license`,
            acquireLicensePage: `${siteUrl}/about`,
            creditText:
                photo.author,
            creator:
                {
                    "@type":
                        "Person",
                    name: photo.author,
                },
            copyrightNotice: `© ${photo.author} ${currentYear}. All rights reserved.`,
            datePublished:
                photo.date,
            keywords:
                photo.tag?.join(
                    ", ",
                ),
            description:
                photo
                    .images[0]
                    .description ||
                photo.name,
            name: photo.name,
            contentLocation:
                photo.location,
        }),
    );
---

<Layout
    title={`GALLERY // ${SITE_CONFIG.title}`}
    description="A curated collection of visual moments."
    preconnectImageServer={true}
>
    {
        ldJsons.map(
            (
                schema,
            ) => (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={JSON.stringify(
                        schema,
                    )}
                />
            ),
        )
    }

    <div class="max-w-6xl mx-auto w-full pt-2 sm:pt-4 md:pt-8 pb-16 sm:pb-20">
        <!-- Background Reveal Watermark -->
        <div class="hidden md:flex fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden items-center justify-center">
            <TextReveal
                client:load
                text="Gallery"
                type="char"
                className="font-bold text-black/[0.03] dark:text-white/[0.10] text-[8vh] sm:text-[10vh] lg:text-[18vh] leading-none whitespace-nowrap"
                style={{
                    writingMode: "vertical-rl",
                    textOrientation: "mixed",
                }}
            />
        </div>

        <!-- Horizontal Editorial Header (Balanced, Compact, No Y-axis waste) -->
        <header class="mb-8 sm:mb-10 md:mb-12 pb-5 border-b border-black/5 dark:border-white/5 flex flex-col md:flex-row md:items-end justify-between gap-4 md:gap-8">
            <!-- Left Column: Eyebrow + Large Serif Title -->
            <div class="shrink-0">
                <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-black/40 dark:bg-white/40"></span>
                    <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text">
                        Visual Archive & Moments
                    </span>
                </div>
                <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal leading-tight tracking-tight text-primary-text">
                    Gallery.
                </h1>
            </div>

            <!-- Right Column: Description + Total Collection Counter -->
            <div class="max-w-md md:text-right flex flex-col md:items-end gap-2 pb-0.5">
                <p class="text-[13px] sm:text-sm font-light leading-relaxed text-secondary-text dark:text-gray-400">
                    Photographic series, light studies, and spatial fragments captured across journeys and seasons.
                </p>
                <div class="text-[10px] sm:text-[11px] font-mono text-secondary-text/50 uppercase tracking-widest">
                    // {photos.length} {photos.length === 1 ? 'CURATED COLLECTION' : 'CURATED COLLECTIONS'}
                </div>
            </div>
        </header>

        <!-- Full-Width Adaptive Photography Grid (Zero wasted side space, scales gracefully to 50+ albums) -->
        <div class="w-full">
            <PhotoGrid
                client:load
                photos={photos}
            />
        </div>
    </div>
</Layout>
