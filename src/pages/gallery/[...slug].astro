---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getPhotos } from "@/utils/photos";
import ExhibitionStream from "@/components/gallery/ExhibitionStream";
import { RiArrowLeftLine } from "@remixicon/react";

export async function getStaticPaths() {
    const photos = await getPhotos();
    return photos.map((photo) => ({
        params: {
            slug: photo.slug,
        },
        props: {
            photo,
        },
    }));
}

const { photo } = Astro.props;
const siteUrl = Astro.site
    ? Astro.site.toString().replace(/\/$/, "")
    : `${SITE_CONFIG.site}`;
const currentYear = new Date().getFullYear();

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: SITE_CONFIG.site,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Gallery",
            item: `${SITE_CONFIG.site}/gallery`,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: photo.name,
            item: `${SITE_CONFIG.site}/gallery/${photo.slug}`,
        },
    ],
};

const imageSchemas = photo.images.map((image, index) => ({
    "@context": "https://schema.org/",
    "@type": "ImageObject",
    contentUrl: image.url,
    license: `${siteUrl}/license`,
    acquireLicensePage: `${siteUrl}/about`,
    creditText: photo.author,
    creator: {
        "@type": "Person",
        name: photo.author,
    },
    copyrightNotice: `© ${photo.author} ${currentYear}. All rights reserved.`,
    datePublished: photo.date,
    keywords: photo.tag?.join(", "),
    description: image.description || `${photo.name} #${index + 1}`,
    name: image.alt || `${photo.name} #${index + 1}`,
    contentLocation: photo.location,
}));
---

<Layout
    title={`${photo.name} // ${SITE_CONFIG.title}`}
    description={photo.images[0]?.description || photo.name}
    preconnectImageServer={true}
>
    <!-- Structured Data -->
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    {
        imageSchemas.map((schema) => (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(schema)}
            />
        ))
    }

    <div class="max-w-6xl mx-auto w-full pt-2 sm:pt-4 pb-28 font-sans px-4 sm:px-6 md:px-8">
        <!-- Magazine / Editorial Spread Stream (Pure photography, zero text clutter) -->
        <ExhibitionStream
            client:load
            photo={photo}
        />

        <!-- Understated Colophon -->
        <footer class="mt-28 sm:mt-40 pt-10 border-t border-black/5 dark:border-white/5 flex items-center justify-between text-xs text-secondary-text/50 font-mono">
            <a
                href="/gallery"
                class="inline-flex items-center gap-1.5 hover:text-primary-text transition-colors"
            >
                <RiArrowLeftLine className="w-3.5 h-3.5" />
                <span>Back to Gallery</span>
            </a>
            {
                photo.tag && photo.tag.length > 0 && (
                    <div class="flex items-center gap-3">
                        {photo.tag.map((tag: string) => (
                            <span class="opacity-70">#{tag}</span>
                        ))}
                    </div>
                )
            }
        </footer>
    </div>
</Layout>
