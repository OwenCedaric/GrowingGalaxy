---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getCollection } from "astro:content";
import TracesExplorer from "@/components/traces/TracesExplorer";
import TextReveal from "@/components/ui/TextReveal";

const allTraces =
    await getCollection(
        "traces",
    );
const totalCount = allTraces.length;

export interface TraceDestination {
    id: string;
    name: string;
    siteName?: string;
    environment?: string;
    description: string;
    photos: string[];
    detailUrl: string;
    coordinates: string;
    mapUrl?: string;
    dateStr: string;
}

export interface TraceYear {
    year: number;
    destinations: TraceDestination[];
}

function extractTraceInfo(
    body: string,
) {
    const lines =
        body.split(
            "\n",
        );
    let description =
        "";
    const photos: string[] =
        [];

    for (const line of lines) {
        const trimmed =
            line.trim();
        if (
            !trimmed
        )
            continue;

        // Match markdown image: ![alt](url)
        const imgMatch =
            trimmed.match(
                /!\[.*?\]\((.*?)\)/,
            );
        if (
            imgMatch
        ) {
            if (
                photos.length <
                3
            ) {
                photos.push(
                    imgMatch[1],
                );
            }
        } else if (
            !description &&
            !trimmed.startsWith(
                "#",
            ) &&
            !trimmed.startsWith(
                "<",
            )
        ) {
            description =
                trimmed;
        }
    }
    return {
        description,
        photos,
    };
}

// Group by year descending
const tracesByYear =
    allTraces.reduce(
        (
            acc,
            trace,
        ) => {
            const year =
                trace.data.endDate.getFullYear();
            if (
                !acc[
                    year
                ]
            )
                acc[
                    year
                ] =
                    [];
            acc[
                year
            ].push(
                trace,
            );
            return acc;
        },
        {} as Record<
            number,
            typeof allTraces
        >,
    );

const sortedYears =
    Object.keys(
        tracesByYear,
    )
        .map(
            Number,
        )
        .sort(
            (
                a,
                b,
            ) =>
                b -
                a,
        );

// Transform to TraceYear schema
const traceYears: TraceYear[] =
    sortedYears.map(
        (
            year,
        ) => {
            const tracesForYear =
                tracesByYear[
                    year
                ].sort(
                    (
                        a,
                        b,
                    ) =>
                        b.data.endDate.valueOf() -
                        a.data.endDate.valueOf(),
                );

            const destinations: TraceDestination[] =
                tracesForYear.map(
                    (
                        trace,
                    ) => {
                        const {
                            description,
                            photos,
                        } =
                            extractTraceInfo(
                                trace.body ||
                                    "",
                            );

                        const cleanCity = trace.data.site_name
                            ? trace.data.site_name.split(",")[0].trim()
                            : trace.data.title.replace(/^SYS_TRACE:\s*/i, "");

                        return {
                            id: trace.id,
                            name: cleanCity,
                            siteName: trace.data.site_name,
                            environment: trace.data.baseline?.environment,
                            description: description || "",
                            photos: photos,
                            detailUrl: `/traces/${trace.id}`,
                            coordinates:
                                trace
                                    .data
                                    .baseline
                                    .coordinates,
                            mapUrl: trace
                                .data
                                .baseline
                                .mapUrl,
                            dateStr:
                                trace
                                    .data
                                    .date, // Now a string directly from frontmatter
                        };
                    },
                );
            return {
                year,
                destinations,
            };
        },
    );
---

<Layout
    title={`TRACES // ${SITE_CONFIG.title}`}
    description="Geographic logs and traces."
>
    <div
        class="max-w-6xl mx-auto w-full pt-1 sm:pt-2 md:pt-4 pb-16 sm:pb-20"
    >
        <!-- Background Reveal Watermark -->
        <div
            class="hidden md:flex fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden items-center justify-center"
        >
            <TextReveal
                client:load
                text="Traces"
                type="char"
                className="font-bold text-black/[0.03] dark:text-white/[0.10] text-[8vh] sm:text-[10vh] lg:text-[18vh] leading-none whitespace-nowrap"
                style={{
                    writingMode:
                        "vertical-rl",
                    textOrientation:
                        "mixed",
                }}
            />
        </div>

        <!-- Editorial Left-Right Header (Preserves rich narrative while eliminating Y-axis space waste) -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-10 mb-8 md:mb-12">
            <!-- Left Column: Status Eyebrow + Large Serif Title -->
            <div class="shrink-0">
                <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-black/40 dark:bg-white/40"></span>
                    <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text">
                        Geographic Logs & Expeditions
                    </span>
                </div>
                <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight tracking-tight text-primary-text">
                    Traces.
                </h1>
            </div>

            <!-- Right Column: Description Paragraph + Status Counter -->
            <div class="max-w-md md:text-right flex flex-col md:items-end gap-2 pb-0.5">
                <p class="text-[13px] sm:text-sm font-light leading-relaxed text-secondary-text dark:text-gray-400">
                    Physical waypoints, ambient field recordings, and memory coordinates across time and space.
                </p>
                <div class="text-[10px] sm:text-[11px] font-mono text-secondary-text/50 uppercase tracking-widest">
                    // {totalCount} {totalCount === 1 ? 'RECORDED DESTINATION' : 'RECORDED DESTINATIONS'}
                </div>
            </div>
        </div>

        <TracesExplorer
            client:load
            data={traceYears}
        />
    </div>
</Layout>
